        <geom type="mesh" rgba="0.64706 0.61961 0.58824 1" mesh="left_rod"/>
        <site name='P2L' pos ='0 0 0.28825'/>
      </body>
    </body>
    <body name="right_mid" pos="0.02 0.03 0">
      <inertial pos="-1.036e-07 0 0.0016437" quat="1 -7.59829e-05 8.55466e-09 0.000112587" mass="0.0077202" diaginertia="1.3182e-07 1.1908e-07 9.0186e-08"/>
      <joint name="psi1" pos="0 0 0" axis="0 1 0" range="-1.5707 1.5707"/>
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.64706 0.61961 0.58824 1" mesh="right_mid"/>
