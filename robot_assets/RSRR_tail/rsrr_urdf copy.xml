<mujoco model="rsrr_urdf">
  <compiler angle="radian" meshdir="meshes/"/>
  <option>
    <flag contact = 'disable'/>
  </option>
  
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  
  <default>
    <motor ctrlrange="-8 8"/>
    <equality solref='0.00000001 1'/>
  </default>

  <contact>
    <exclude body1 = 'world' body2 = 'left_mid' />
    <exclude body1 = 'world' body2 = 'right_mid'/>
    <exclude body1 = 'world' body2 = 'main_mid' />
    <exclude body1 = 'right_rod' body2 = 'motor_right' />
    <exclude body1 = 'left_rod' body2 = 'motor_left' />
    <exclude body1 = 'motor_right' body2 = 'main_mid' />
    <exclude body1 = 'motor_left' body2 = 'main_mid' />
    <exclude body1 = 'left_mid' body2 = 'left_rod' />
    <exclude body1 = 'right_mid' body2 = 'right_rod' />
    <exclude body1 = 'main_mid' body2 = 'main_rod' />
  </contact>

  <equality>
    <connect site1 = 'P1L' site2 = 'P2L'/>
    <connect site1 = 'P1R' site2 = 'P2R'/>
  </equality>

  <asset>
    <mesh name="base_link" content_type="model/stl" file="base_link.STL"/>
    <mesh name="left_mid" content_type="model/stl" file="left_mid.STL"/>
    <mesh name="left_rod" content_type="model/stl" file="left_rod.STL"/>
    <mesh name="right_mid" content_type="model/stl" file="right_mid.STL"/>
    <mesh name="right_rod" content_type="model/stl" file="right_rod.STL"/>
    <mesh name="main_mid" content_type="model/stl" file="main_mid.STL"/>
    <mesh name="main_rod" content_type="model/stl" file="main_rod.STL"/>
    <mesh name="motor_left" content_type="model/stl" file="motor_left.STL"/>
    <mesh name="motor_right" content_type="model/stl" file="motor_right.STL"/>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <actuator>
    <motor name="motor_left" joint="theta1" />
    <motor name="motor_right" joint="theta2" />
    <motor joint="phi1" />
    <motor joint="phi2" />
    <motor joint="psi1" />
    <motor joint="psi2" />
    <motor joint="alpha1" />
    <motor joint="alpha2" />
  </actuator>
  
  <sensor>
    <jointpos name="theta1_pos" joint="theta1" noise="0"/>
    <jointpos name="theta2_pos" joint="theta2" noise="0"/>
    <jointpos name="phi1_pos" joint="phi1" noise="0"/>
    <jointpos name="phi2_pos" joint="phi2" noise="0"/>
    <jointpos name="psi1_pos" joint="psi1" noise="0"/>
    <jointpos name="psi2_pos" joint="psi2" noise="0"/>
    <jointpos name="alpha1_pos" joint="alpha1" noise="0"/>
    <jointpos name="alpha2_pos" joint="alpha2" noise="0"/>

    <jointvel name="theta1_vel" joint="theta1" noise="0"/>
    <jointvel name="theta2_vel" joint="theta2" noise="0"/>
    <jointvel name="phi1_vel" joint="phi1" noise="0"/>
    <jointvel name="phi2_vel" joint="phi2" noise="0"/>
    <jointvel name="psi1_vel" joint="psi1" noise="0"/>
    <jointvel name="psi2_vel" joint="psi2" noise="0"/>
    <jointvel name="alpha1_vel" joint="alpha1" noise="0"/>
    <jointvel name="alpha2_vel" joint="alpha2" noise="0"/>

    <jointactuatorfrc name="theta1_torque" joint="theta1" noise="0"/>
    <jointactuatorfrc name="theta2_torque" joint="theta2" noise="0"/>
    <jointactuatorfrc name="psi1_torque" joint="psi1" noise="0"/>
    <jointactuatorfrc name="psi2_torque" joint="psi2" noise="0"/>
    <jointactuatorfrc name="phi1_torque" joint="phi1" noise="0"/>
    <jointactuatorfrc name="phi2_torque" joint="phi2" noise="0"/>
    <jointactuatorfrc name="alpha1_torque" joint="alpha1" noise="0"/>
    <jointactuatorfrc name="alpha2_torque" joint="alpha2" noise="0"/>

    <force name="force" site="ft_sensor" />
    <torque name="torque" site="ft_sensor" />
  </sensor>


  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos='0 0 -.5'size="0 0 0.05" type="plane" material="groundplane"/>
