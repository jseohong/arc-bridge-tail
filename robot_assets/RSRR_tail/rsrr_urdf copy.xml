    </body>
    <body name="main_mid">
      <inertial pos="1.7091e-07 0 0.0014798" quat="0.707038 0.707176 -1.93018e-05 -1.93056e-05" mass="0.016979" diaginertia="5.3266e-07 4.0061e-07 3.4438e-07"/>
      <joint name="alpha1" pos="0 0 0" axis="0 1 0" range="-1.5707 1.5707"/>
      <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.64706 0.61961 0.58824 1" mesh="main_mid"/>
      <geom type="mesh" rgba="0.64706 0.61961 0.58824 1" mesh="main_mid"/>
      <body name="main_rod" pos="0 0 0.015">
        <inertial pos="2.6619e-10 -0.017234 0.27696" quat="0.999912 0.0131594 0.00160446 2.11155e-05" mass="0.25186" diaginertia="0.000779037 0.000657811 0.000137153"/>
        <joint name="alpha2" pos="0 0 0" axis="1 0 0" range="-1.5707 1.5707"/>
        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.64706 0.61961 0.58824 1" mesh="main_rod"/>
        <geom type="mesh" rgba="0.64706 0.61961 0.58824 1" mesh="main_rod"/>
        <body name="motor_left" pos="0 0 0.285">
          <inertial pos="-0.018088 0.0089832 4.1527e-09" quat="0.707105 0.707105 -0.00168255 -0.00168255" mass="0.004295" diaginertia="8.56776e-07 7.1495e-07 1.52664e-07"/>
          <joint name="theta1" pos="0 0 0" axis="1 0 0" range="-1.5707 1.5707" damping="0.1" armature="0.01" frictionloss="0.2"/>
          <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.89804 0.91765 0.92941 1" mesh="motor_left"/>
          <geom type="mesh" rgba="0.89804 0.91765 0.92941 1" mesh="motor_left"/>
          <site name='P1L' pos ='-0.0128 0.030 0'/>
        </body>
        <body name="motor_right" pos="0 -0.0010529 0.325">
          <inertial pos="0.018088 0.0089832 -3.9744e-09" quat="0.707105 0.707105 0.00168255 0.00168255" mass="0.004295" diaginertia="8.56776e-07 7.1495e-07 1.52664e-07"/>
          <joint name="theta2" pos="0 0 0" axis="1 0 0" range="-1.5707 1.5707" damping="0.1" armature="0.01" frictionloss="0.2"/>
          <geom type="mesh" contype="0" conaffinity="0" group="1" density="0" rgba="0.89804 0.91765 0.92941 1" mesh="motor_right"/>
          <geom type="mesh" rgba="0.89804 0.91765 0.92941 1" mesh="motor_right"/>
