        <inertial pos="-9.6288e-10 -3.389e-08 0.078858" quat="0.707107 0 0 0.707107" mass="0.015417" diaginertia="4.2268e-05 4.2245e-05 1.474e-07"/>
        <joint name="phi2" pos="0 0 0" axis="1 0 0" range="-1.5707 1.5707"/>
